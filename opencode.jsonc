{
  "$schema": "https://opencode.ai/config.json",
  "model": "cliproxy/claude-opus-5",
  "instructions": [
    "/etc/opencode/hindsight-agent.md"
  ],
  "providers": {
    "cliproxy": {
      "name": "CLIProxy",
      "env": [
        "CLIPROXY_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://cliproxy.hangocthanh.io.vn/v1",
        "apiKey": "{env:CLIPROXY_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "modelID": "deepseek-v4-flash"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "modelID": "claude-opus-5"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "hindsight": {
        "type": "remote",
        "url": "https://172.31.250.36:8888/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:HINDSIGHT_API_KEY}",
          "X-Bank-Id": "opencode2"
        }
      }
    }
  }
}
